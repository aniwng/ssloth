# Copy to .env in this directory. Used by the Astro site (build time) and the
# automation script. The Sanity Studio needs its own — see sanity/.env.example.

# --- Sanity -----------------------------------------------------------------
# From sanity.io/manage after `npx sanity init`. Until this is set, the Astro
# site builds from the local seed content in astro/src/lib/seed/roundups.json.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# Editor-scoped token, sanity.io/manage -> API -> Tokens. Write access — the
# generate script needs it, the site does not. Never commit this.
SANITY_WRITE_TOKEN=

# --- Claude -----------------------------------------------------------------
# Only the generate script uses this. Alternatively run `ant auth login` and
# leave it unset — the SDK picks up the profile automatically.
ANTHROPIC_API_KEY=

# Optional overrides for the generate script.
# SLOTH_MODEL=claude-opus-5
# SLOTH_EFFORT=high          # low | medium | high | xhigh | max
# SLOTH_MAX_TOKENS=32000
# SLOTH_WEB_SEARCH=1         # 0 disables grounding in live reviews

# --- Site -------------------------------------------------------------------
# Canonical URL, read by astro.config.mjs. Note astro.config runs before .env
# is loaded, so this one has to be a real environment variable (set it in your
# host's build settings), not a line in this file.
# SITE_URL=https://shoppingsloth.com
