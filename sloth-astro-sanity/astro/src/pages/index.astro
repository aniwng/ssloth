---
import BaseLayout from '../layouts/BaseLayout.astro'
import PawIcon from '../components/PawIcon.astro'
import ProductImage from '../components/ProductImage.astro'
import RoundupCard from '../components/RoundupCard.astro'
import {getRoundups, CATEGORIES, formatMonth} from '../lib/roundups.js'

const roundups = await getRoundups()
// The newest roundup is promoted into the hero so the fold carries real
// content, not just a tagline. The grid below picks up from the second.
const [featured, ...rest] = roundups
const latest = rest.slice(0, 6)
const featuredUpdated = featured ? formatMonth(featured.updatedAt ?? featured.publishedAt) : null

// Search covers every roundup, not just the handful rendered on this page —
// otherwise a query for something in the archive would come back empty. The
// index is small (title/category/slug only) and inlined rather than fetched,
// since the whole site is static and this avoids a runtime API to maintain.
const searchIndex = roundups.map((r) => ({slug: r.slug, title: r.title, category: r.category}))
---

<BaseLayout title="Shopping Sloth — Slow Picks. Fast Results." image={featured?.heroImage}>
  <section class="hero">
    <div class="paw-trail" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">
          <PawIcon size={12} />
          no rush, just really good picks
        </div>
        <h1>Slow picks.<br />Fast results.</h1>
        <p>Every pick here is checked against real reviews and testing data, so you don't have to hurry into a bad purchase.</p>
        <div class="search">
          <label>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
            </svg>
            <input
              type="text"
              placeholder="search for a product roundup"
              aria-label="Search roundups"
              autocomplete="off"
              role="combobox"
              aria-expanded="false"
              aria-controls="search-dropdown"
              data-search
            />
          </label>
          <div class="search-dropdown" id="search-dropdown" role="listbox" data-search-dropdown hidden></div>
        </div>
        <script type="application/json" data-search-index set:html={JSON.stringify(searchIndex)} />
        <nav class="hero-cats" aria-label="Categories">
          {
            CATEGORIES.map((category) => (
              <a class={`hero-cat cat-${category}`} href={`/category/${category}/`}>
                {category}
              </a>
            ))
          }
        </nav>
      </div>

      {
        featured && (
          <a class={`featured cat-${featured.category}`} href={`/${featured.slug}/`}>
            <div class={featured.heroImage ? 'featured-img' : 'featured-img ph'}>
              <ProductImage source={featured.heroImage} width={880} height={550} alt={featured.title} eager />
            </div>
            <div class="featured-body">
              <div class="featured-flag">
                <PawIcon size={11} />
                newest roundup
              </div>
              <div class="featured-title">{featured.title}</div>
              <div class="featured-meta">
                <span class={`tag ${featured.category}`}>{featured.category}</span>
                {featuredUpdated && <span class="card-meta">updated {featuredUpdated}</span>}
              </div>
            </div>
          </a>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <PawIcon size={13} />
        <h2>more roundups</h2>
        {
          roundups.length > latest.length + 1 && (
            <a class="section-link" href="/roundups/">
              view all {roundups.length} <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
      {
        latest.length ? (
          <div class="grid">
            {latest.map((roundup) => (
              <RoundupCard roundup={roundup} />
            ))}
          </div>
        ) : (
          <div class="empty">
            No roundups published yet. Run <code>npm run generate</code> in <code>scripts/</code>, or add
            one in the Studio.
          </div>
        )
      }
    </div>
  </section>

  <section class="section" id="categories">
    <div class="wrap">
      <div class="section-head"><h2>browse by category</h2></div>
      <div class="cat-row">
        {
          CATEGORIES.map((category) => (
            <a class={`cat-pill cat-${category}`} href={`/category/${category}/`}>
              {category}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="quote">
        <p>"We move slow, but only toward the good stuff."</p>
        <span>— the shopping sloth team</span>
      </div>
    </div>
  </section>

  <script>
    // Typeahead dropdown under the search box — deliberately dumb (substring
    // match over an inlined title/category list, no search service) until
    // there are enough roundups to need more. Results are real links, not a
    // filter over the page's own content, so this doesn't disturb "more
    // roundups" below and covers the whole archive, not just what's rendered
    // on this page.
    const input = document.querySelector('[data-search]')
    const dropdown = document.querySelector('[data-search-dropdown]')
    const indexEl = document.querySelector('[data-search-index]')
    const index = indexEl ? JSON.parse(indexEl.textContent) : []

    const CATEGORY_LABEL = {health: 'health', tech: 'tech', home: 'home', accessories: 'accessories'}

    function render(query) {
      const q = query.trim().toLowerCase()
      if (!q) return close()

      const matches = index
        .filter((r) => r.title.toLowerCase().includes(q) || r.category.toLowerCase().includes(q))
        .slice(0, 8)

      dropdown.innerHTML = matches.length
        ? matches
            .map(
              (r) => `
                <a class="search-result" href="/${r.slug}/" role="option">
                  <span class="search-result-title">${escapeHtml(r.title)}</span>
                  <span class="tag ${r.category}">${escapeHtml(CATEGORY_LABEL[r.category] ?? r.category)}</span>
                </a>
              `,
            )
            .join('')
        : `<p class="search-empty">Nothing matches that search — try a broader word.</p>`

      open()
    }

    function open() {
      dropdown.hidden = false
      input.setAttribute('aria-expanded', 'true')
    }

    function close() {
      dropdown.hidden = true
      input.setAttribute('aria-expanded', 'false')
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'})[c])
    }

    input?.addEventListener('input', () => render(input.value))
    input?.addEventListener('focus', () => {
      if (input.value.trim()) render(input.value)
    })

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Node)) return
      if (!dropdown.contains(e.target) && e.target !== input) close()
    })

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    })
  </script>
</BaseLayout>
