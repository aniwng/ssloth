---
import BaseLayout from '../layouts/BaseLayout.astro'
import PawIcon from '../components/PawIcon.astro'
---

<BaseLayout
  title="Contact — Shopping Sloth"
  description="Get in touch with Shopping Sloth about a roundup, a correction, or anything else."
>
  <div class="wrap prose" style="max-width:760px;">
    <div class="page-head">
      <div class="eyebrow">
        <PawIcon size={12} />
        contact
      </div>
      <h1>Get in touch</h1>
    </div>

    <p>
      Spotted something outdated, found a broken link, or want to flag a product we should look at? We
      read everything sent our way.
    </p>

    <p>
      Email us directly at <a href="mailto:annie@duck.com">annie@duck.com</a> and we'll get back to you.
    </p>

    <h2>What we're best at answering</h2>
    <p>
      Corrections on pricing or availability, broken affiliate links, and suggestions for products or
      categories worth covering. For press or partnership inquiries, use the same address and mention
      that up front.
    </p>
  </div>
</BaseLayout>
