---
import '../styles/style.css'

const {
  title,
  description = "Every pick here is checked against real reviews and testing data, so you don't have to hurry into a bad purchase.",
} = Astro.props

const path = Astro.url.pathname
const isHome = path === '/'
const isAbout = path.startsWith('/about')
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img src="/sloth-mark.svg" alt="" class="brand-mark" />
          shopping sloth
        </a>
        <nav class="nav">
          <a href="/" class={isHome ? 'is-current' : undefined}>home</a>
          <a href="/#categories">categories</a>
          <a href="/about/" class={isAbout ? 'is-current' : undefined}>about</a>
        </nav>
        <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div>
            <div class="footer-brand">
              <img src="/sloth-mark.svg" alt="" class="brand-mark" />
              shopping sloth
            </div>
            <div class="footer-tagline">Slow picks. Fast results.</div>
          </div>
          <nav class="footer-nav">
            <a href="/">home</a>
            <a href="/#categories">categories</a>
            <a href="/about/">about</a>
          </nav>
        </div>
        <div class="footer-legal">
          <!-- Affiliate disclosure appears on every page. Keep it. -->
          <span>contains affiliate links · we may earn a commission</span>
          <span>© {year} shopping sloth</span>
        </div>
      </div>
    </footer>

    <script>
      document.querySelectorAll('.nav-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const nav = document.querySelector('.nav')
          const open = nav.classList.toggle('open')
          btn.setAttribute('aria-expanded', String(open))
        })
      })
    </script>
  </body>
</html>
