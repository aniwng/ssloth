---
import '../styles/style.css'

const {
  title,
  description = 'Buying-guide roundups built from published reviews and testing, with the sources cited on every article.',
  image,
  type = 'website',
  jsonLd,
  // Set to 'noindex, follow' for pages that exist for navigation rather than
  // for reading — paginated archive pages past the first, mainly. They carry
  // almost no text of their own, and a crawl full of near-empty list pages
  // drags down how the site reads in aggregate. 'follow' still lets the
  // articles behind them be discovered.
  robots,
} = Astro.props

const path = Astro.url.pathname
const isHome = path === '/'
const isAbout = path.startsWith('/about')
const isArchive = path.startsWith('/roundups')
const year = new Date().getFullYear()
const canonicalUrl = new URL(path, Astro.site)
const absoluteImage = image ? new URL(image, Astro.site).toString() : undefined

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Shopping Sloth',
  url: Astro.site?.toString(),
  description:
    'Buying-guide roundups built from published reviews and testing, with the sources cited on every article.',
  publisher: {
    '@type': 'Organization',
    name: 'Shopping Sloth',
    url: Astro.site?.toString(),
    // Declares the site's editorial policy where crawlers look for it. The
    // page it points at is also what a human reviewer opens first.
    publishingPrinciples: new URL('/how-we-pick/', Astro.site).toString(),
  },
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Shopping Sloth" />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    {(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <meta name="google-adsense-account" content="ca-pub-4145026914264633" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4145026914264633"
      crossorigin="anonymous"></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4WZ144ZKN6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4WZ144ZKN6');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img src="/sloth-mark.svg" alt="" class="brand-mark" />
          shopping sloth
        </a>
        <nav class="nav">
          <a href="/" class={isHome ? 'is-current' : undefined}>home</a>
          <a href="/roundups/" class={isArchive ? 'is-current' : undefined}>roundups</a>
          <a href="/#categories">categories</a>
          <a href="/about/" class={isAbout ? 'is-current' : undefined}>about</a>
        </nav>
        <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div>
            <div class="footer-brand">
              <img src="/sloth-mark.svg" alt="" class="brand-mark" />
              shopping sloth
            </div>
            <div class="footer-tagline">Slow picks. Fast results.</div>
          </div>
          <nav class="footer-nav">
            <a href="/">home</a>
            <a href="/roundups/">all roundups</a>
            <a href="/#categories">categories</a>
            <a href="/how-we-pick/">how we pick</a>
            <a href="/about/">about</a>
            <a href="/contact/">contact</a>
            <a href="/privacy/">privacy policy</a>
          </nav>
        </div>
        <div class="footer-legal">
          <!-- Affiliate disclosure appears on every page. Keep it. -->
          <span>as an Amazon Associate we earn from qualifying purchases</span>
          <span>© {year} shopping sloth</span>
        </div>
      </div>
    </footer>

    <script>
      document.querySelectorAll('.nav-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const nav = document.querySelector('.nav')
          const open = nav.classList.toggle('open')
          btn.setAttribute('aria-expanded', String(open))
        })
      })
    </script>
  </body>
</html>
